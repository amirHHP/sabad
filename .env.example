# Sabad (سبد) Configuration File
# Copy this file to .env and customize as needed: cp .env.example .env

# Geolocation Coordinates (Default: Central Tehran - Keshavarz Blvd / Valiasr)
LATITUDE=35.715298
LONGITUDE=51.404343

# User Phone Number for Platform Authentication (Format: 09XXXXXXXXX)
SNAPP_MARKET_PHONE=09120000000
DIGIKALA_JET_PHONE=09120000000
OKALA_PHONE=09120000000

# Optimization Settings
DEFAULT_SPLIT_PENALTY_TOMANS=25000
ENABLE_MULTI_STORE_SPLIT=true

# Optional LLM API Configuration (for enhanced semantic parsing)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.5-flash-lite
